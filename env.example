# For LOCAL testing only. Copy to soilsense_agent/.env (ignored by git). NEVER commit real keys.
# On Streamlit Cloud put the same names in the app's Secrets instead.
# Free keys: Gemini -> aistudio.google.com   Groq -> console.groq.com   OpenRouter -> openrouter.ai
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional switches
USE_MOCK=false
USE_POWER_API=true
ENABLED_LANGS=ar,en,bn
SS_AGENT_ENABLE_VOICE=false
